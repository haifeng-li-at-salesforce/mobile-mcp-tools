{
  "name": "@salesforce/mcp-rag",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "description": "Section-Level Hybrid Retrieval System for Markdown Documentation",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 --config ../../eslint.config.mjs \"{src,tests}/**/*.ts\"",
    "format": "prettier --write \"{src,tests}/**/*.ts\""
  },
  "dependencies": {
    "@litertjs/core": "^0.2.1",
    "@orama/orama": "^3.1.5",
    "@tensorflow/tfjs-node": "^4.22.0",
    "marked": "^15.0.6",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
